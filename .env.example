# Copy to .env.local for local development. Never commit .env.local.

# Postgres. Locally: `pnpm db:up` starts one in OrbStack on port 54329.
# On Vercel the Neon integration sets DATABASE_URL (pooled) and DATABASE_URL_UNPOOLED.
DATABASE_URL=postgres://michi:michi@localhost:54329/michi
# Migrations prefer a direct (unpooled) connection when there is one.
# DATABASE_URL_UNPOOLED=

# Tests create throwaway databases on this server (default: the local one above).
TEST_DATABASE_URL=postgres://michi:michi@localhost:54329/michi

# The passphrase's scrypt hash: run `pnpm auth:hash` and paste the line it prints.
PASSPHRASE_HASH=
# The key that signs the sign-in cookie, at least 32 characters: `pnpm auth:secret`.
# Changing it signs every device out.
SESSION_SECRET=
