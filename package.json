{
  "name": "michi",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "pnpm db:deploy && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "pnpm typecheck && eslint && vitest run && next build",
    "db:up": "docker compose up -d --wait",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db.ts migrate",
    "db:seed": "tsx scripts/db.ts seed",
    "db:deploy": "tsx scripts/db.ts deploy",
    "auth:hash": "node scripts/auth-hash.mjs",
    "auth:secret": "node scripts/auth-secret.mjs",
    "icons": "node scripts/draw-icons.mjs",
    "content:build": "tsx scripts/content/build.ts",
    "content:links": "tsx scripts/content/links.ts",
    "content:check-writing": "tsx scripts/content/check-writing.ts"
  },
  "packageManager": "pnpm@12.14.0",
  "dependencies": {
    "@vercel/functions": "^3.11.3",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.6",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "ts-fsrs": "6.0.0",
    "wanakana": "5.3.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4.3.5",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": "24.x"
  }
}
